{
  "name": "@pmp/desktop",
  "productName": "Pocket Money Pal",
  "version": "0.1.0",
  "private": true,
  "description": "Pocket Money Pal kiosk app",
  "author": "Chris Hammond-Ross",
  "license": "ISC",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "stage": "node scripts/stage-server.mjs",
    "dev": "npm run build && npm run stage && node scripts/launch.mjs",
    "dist": "npm run build && npm run stage && electron-builder --win --publish never",
    "typecheck": "tsc --noEmit",
    "release": "npm run build && npm run stage && electron-builder --win --publish always",
    "store": "npm run build && npm run stage && electron-builder --win appx --publish never"
  },
  "build": {
    "appId": "io.github.pocketmoneypal",
    "productName": "Pocket Money Pal",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".stage/server",
        "to": "server"
      },
      {
        "from": ".stage/server/node_modules",
        "to": "server/node_modules"
      },
      {
        "from": "dist/startup-task.exe",
        "to": "startup-task.exe"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "artifactName": "Pocket-Money-Pal-Setup-${version}.${ext}"
    },
    "appx": {
      "identityName": "ChrisHammond-Ross.PocketMoneyPal",
      "publisher": "CN=FC1F6890-7D89-499A-AB3A-A178B34B90A8",
      "publisherDisplayName": "Chris Hammond-Ross",
      "applicationId": "PocketMoneyPal",
      "displayName": "Pocket Money Pal",
      "backgroundColor": "#161525",
      "languages": [
        "en-AU"
      ],
      "customManifestPath": "appxmanifest.xml",
      "minVersion": "10.0.18362.0",
      "maxVersionTested": "10.0.26100.0",
      "artifactName": "Pocket-Money-Pal-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "chris-hammond-ross",
      "repo": "pocket-money-pal",
      "releaseType": "release"
    }
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9"
  }
}
